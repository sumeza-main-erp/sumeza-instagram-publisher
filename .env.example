# GCP project that holds the Instagram access token in Secret Manager.
GCP_PROJECT_ID=

# Name (id) of the Secret Manager secret holding the long-lived Instagram
# access token — the SAME secret your website already reads for the reels
# embed. This service only ever reads the latest version; it never writes
# to it. Token refresh stays the ERP backend's job.
IG_TOKEN_SECRET_NAME=

# Instagram professional account id (the "IG_ID" in Meta's docs) that owns
# the posts/messages. Same account the website embed already points at.
IG_BUSINESS_ACCOUNT_ID=
